# Copia in .env e usa valori nuovi; nessuna credenziale locale finisce nell'immagine.
DB_NAME=eaproject
DB_USER=eaproject
DB_PASSWORD=
# Genera con: openssl rand -base64 32
JWT_SECRET=
BACKEND_HOST=127.0.0.1
# Android e JavaFX si collegano a https://localhost:8443
BACKEND_PORT=8443
# Il keystore del team va copiato in certs/server.p12 (stesso certificato di ea_cert.cer e dev-ca.crt)
SERVER_SSL_ENABLED=true
SSL_KEYSTORE=file:/app/certs/server.p12
SSL_KEYSTORE_PASSWORD=
