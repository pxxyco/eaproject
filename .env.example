# Copia in .env e usa valori nuovi; nessuna credenziale locale finisce nell'immagine.
DB_NAME=eaproject
DB_USER=eaproject
DB_PASSWORD=
# Genera con: openssl rand -base64 32
JWT_SECRET=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
# Per il collaudo locale HTTP. Per HTTPS monta certs/server.p12 e abilita TLS.
SERVER_SSL_ENABLED=false
SSL_KEYSTORE=file:/app/certs/server.p12
SSL_KEYSTORE_PASSWORD=
