<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox stylesheets="@../../../css/app.css" minWidth="400.0" spacing="4" styleClass="risposta-item"
    xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="it.unical.ea_project_javafx.controller.activity.reviews.ResponseItemController">

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label styleClass="risposta-badge" text="Risposta del proprietario" />
        <Region HBox.hgrow="ALWAYS" />
        <MenuButton fx:id="btnResponseActions" mnemonicParsing="false" styleClass="btn-actions"
            text="⋮">
            <items>
                <MenuItem onAction="#handleEdit" text="Modifica" />
                <MenuItem onAction="#handleDelete" styleClass="menu-delete" text="Elimina" />
            </items>
        </MenuButton>
    </HBox>

    <Label fx:id="lblTestoRisposta" styleClass="risposta-testo" text="testo risposta"
        wrapText="true" />
    <Label fx:id="lblDataRisposta" styleClass="risposta-data" text="data" />

</VBox>