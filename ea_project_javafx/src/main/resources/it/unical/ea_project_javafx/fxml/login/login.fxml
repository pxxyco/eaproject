<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unical.ea_project_javafx.controller.login.AuthWizardController"
           styleClass="root-pane">
    <stylesheets>
        <URL value="@../../css/style.css" />
        <URL value="@../../css/login.css" />
    </stylesheets>

    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" />
    <Region styleClass="bg-overlay" />

    <StackPane alignment="TOP_LEFT">
        <padding><Insets top="20.0" left="20.0" /></padding>
        <HBox spacing="12.0">
            <children>
                <Button onAction="#goToHomeFromButton" styleClass="control-btn" text="←"/>
                <!--- <Button onAction="#stopAnimation" styleClass="control-btn" text="▣"/>  cambio animazione schermata-->
            </children>
        </HBox>
    </StackPane>

    <VBox fx:id="authCard" alignment="CENTER" maxWidth="420.0" maxHeight="-Infinity" styleClass="auth-card">
        <StackPane>
            <fx:include fx:id="stepLogin" source="step-login.fxml" />
            <fx:include fx:id="stepForgotPassword" source="step-forgot-password.fxml" />
            <fx:include fx:id="stepRole" source="step-role.fxml" />
            <fx:include fx:id="stepDetails" source="step-details.fxml" />
            <fx:include fx:id="loadingOverlay" source="../loading-overlay.fxml" />
        </StackPane>
    </VBox>

    <fx:include fx:id="feedbackOverlay" source="feedback-overlay.fxml" />
</StackPane>