<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="splash-pane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unical.ea_project_javafx.controller.SplashScreenController">
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <VBox fx:id="splashContent" alignment="CENTER" spacing="20.0">
        <ImageView fx:id="errorImageView" fitHeight="220.0" fitWidth="220.0" managed="false" preserveRatio="true" visible="false" />

        <Label fx:id="iconLabel" />
        
        <ProgressIndicator fx:id="progressIndicator" />

        <Label fx:id="errorTitleLabel" managed="false" styleClass="splash-title-label" text="Oops, qualcosa è andato storto..." visible="false" />

        <Label fx:id="statusLabel" styleClass="splash-label" text="Connessione al server..." />

        <Label fx:id="errorMessageLabel" managed="false" styleClass="splash-label" visible="false" />

        <HBox fx:id="buttonBox" alignment="CENTER" managed="false" spacing="12.0" visible="false">
            <Button fx:id="retryButton" styleClass="btn-splash" text="Riprova" />
            <Button fx:id="exitButton" styleClass="btn-splash" text="Esci" />
        </HBox>
    </VBox>
</StackPane>