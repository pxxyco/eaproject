<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="it.unical.ea_project_javafx.controller.organizer.AttendeesController">
    <stylesheets>
        <URL value="@../../css/common/style.css" />
        <URL value="@../../css/home/home.css" />
        <URL value="@../../css/profile/profile.css" />
        <URL value="@../../css/organizer/organizer-dashboard.css" />
    </stylesheets>

    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" />
    <Region styleClass="profile-overlay" />

    <BorderPane>
        <top>
            <StackPane fx:id="navbarContainer" />
        </top>
        <center>
            <ScrollPane fitToWidth="true" styleClass="main-scroll">
                <content>
                    <VBox alignment="TOP_CENTER" spacing="24.0">
                        <padding>
                            <Insets bottom="40.0" left="32.0" right="32.0" top="28.0" />
                        </padding>

                        <VBox maxWidth="1050.0" spacing="20.0" styleClass="glass-card">
                            <padding>
                                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                            </padding>

                            <VBox spacing="4.0">
                                <Label styleClass="dash-title"
                                    text="Prenotazioni &amp; Registro Iscritti" />
                                <Label styleClass="dash-subtitle"
                                    text="Monitora in tempo reale le iscrizioni ricevute e controlla lo stato dei pagamenti dei partecipanti." />
                            </VBox>

                            <Label fx:id="statusMessageLabel" managed="false" visible="false"
                                wrapText="true" />

                            <Separator styleClass="nav-divider" />

                            <HBox spacing="16.0">
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label styleClass="kpi-title"
                                        text="Totale Partecipanti Iscritti" />
                                    <Label fx:id="totalAttendeesLabel" styleClass="kpi-value"
                                        text="0" />
                                </VBox>
                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label styleClass="kpi-title" text="Incasso Lordo Confermato" />
                                    <Label fx:id="confirmedRevenueLabel"
                                        styleClass="kpi-value-green" text="€ 0.00" />
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <TextField fx:id="searchField"
                                    promptText="Cerca per nome utente, email o evento..."
                                    styleClass="custom-input" HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="eventFilterCombo" promptText="Seleziona Evento"
                                    styleClass="traveler-search-type" prefWidth="200.0" />
                            </HBox>

                            <TableView fx:id="attendeesTableView" prefHeight="350.0"
                                styleClass="custom-table">
                                <columns>
                                    <TableColumn fx:id="participantColumn" prefWidth="180.0"
                                        text="Partecipante" />
                                    <TableColumn fx:id="emailColumn" prefWidth="220.0"
                                        text="Email Contatto" />
                                    <TableColumn fx:id="eventColumn" prefWidth="220.0"
                                        text="Evento / Viaggio Scelto" />
                                    <TableColumn fx:id="seatsColumn" prefWidth="80.0" text="Posti" />
                                    <TableColumn fx:id="dateColumn" prefWidth="140.0"
                                        text="Data Iscrizione" />
                                    <TableColumn fx:id="statusColumn" prefWidth="120.0"
                                        text="Stato Pagamento" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>

                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>