<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane stylesheets="@../../css/screens/traveler/history.css" fx:id="pageRoot"
    xmlns="http://javafx.com/javafx/21.0.2"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="it.unical.ea_project_javafx.controller.traveler.BookingHistoryController">
    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" />
    <Region styleClass="profile-overlay" />
    <BorderPane fx:id="mainContent">
        <top>
            <StackPane fx:id="navbarContainer" />
        </top>
        <center>
            <StackPane fx:id="historyHost" maxWidth="1120" styleClass="history-host"
                BorderPane.alignment="TOP_CENTER">
                <VBox fx:id="historyHeader" maxWidth="1120" spacing="26" styleClass="history-header">
                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="dash-title" text="Il mio Storico" />
                            <Label styleClass="dash-subtitle"
                                text="Rivedi le esperienze passate, consulta i dettagli delle prenotazioni e gestisci le tue recensioni."
                                wrapText="true" />
                        </VBox>
                        <Button onAction="#handleRefresh" styleClass="btn-secondary"
                            text="↻ Aggiorna" />
                    </HBox>
                    <Label fx:id="statusMessageLabel" managed="false" visible="false"
                        wrapText="true" />
                    <Separator styleClass="nav-divider" />
                    <GridPane hgap="12.0" styleClass="history-stat-row">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25" fillWidth="true" />
                            <ColumnConstraints percentWidth="25" fillWidth="true" />
                            <ColumnConstraints percentWidth="25" fillWidth="true" />
                            <ColumnConstraints percentWidth="25" fillWidth="true" />
                        </columnConstraints>
                        <VBox styleClass="booking-count-card" alignment="CENTER_LEFT" prefWidth="0"
                            maxWidth="Infinity" GridPane.columnIndex="0">
                            <Label fx:id="historyTotalLabel" styleClass="booking-count-value"
                                text="0" maxWidth="Infinity" alignment="CENTER_LEFT" minHeight="48"
                                prefHeight="48" />
                            <Label styleClass="stat-label" text="Nello storico" wrapText="true"
                                minHeight="32" prefHeight="32" />
                        </VBox>
                        <VBox styleClass="booking-count-card" alignment="CENTER_LEFT" prefWidth="0"
                            maxWidth="Infinity" GridPane.columnIndex="1">
                            <Label fx:id="historyCompletedLabel" styleClass="booking-count-value"
                                text="0" maxWidth="Infinity" alignment="CENTER_LEFT" minHeight="48"
                                prefHeight="48" />
                            <Label styleClass="stat-label" text="Concluse" wrapText="true"
                                minHeight="32" prefHeight="32" />
                        </VBox>
                        <VBox styleClass="booking-count-card" alignment="CENTER_LEFT" prefWidth="0"
                            maxWidth="Infinity" GridPane.columnIndex="2">
                            <Label fx:id="historyCancelledLabel" styleClass="booking-count-value"
                                text="0" maxWidth="Infinity" alignment="CENTER_LEFT" minHeight="48"
                                prefHeight="48" />
                            <Label styleClass="stat-label" text="Cancellate" wrapText="true"
                                minHeight="32" prefHeight="32" />
                        </VBox>
                        <VBox styleClass="booking-count-card" alignment="CENTER_LEFT" prefWidth="0"
                            maxWidth="Infinity" GridPane.columnIndex="3">
                            <Label fx:id="historyReviewableLabel" styleClass="booking-count-value"
                                text="0" maxWidth="Infinity" alignment="CENTER_LEFT" minHeight="48"
                                prefHeight="48" />
                            <Label styleClass="stat-label" text="Da recensire" wrapText="true"
                                minHeight="32" prefHeight="32" />
                        </VBox>
                    </GridPane>
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="history-filters">
                        <TextField fx:id="searchField"
                            promptText="Cerca per titolo, luogo o data..."
                            styleClass="custom-input" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="historyFilterCombo" prefWidth="205.0"
                            promptText="Filtra storico" styleClass="traveler-search-type" />
                    </HBox>
                </VBox>
                <VBox fx:id="emptyStateContainer" alignment="CENTER" spacing="10.0"
                    styleClass="history-empty-state" visible="false" managed="false">
                    <Label fx:id="emptyTitleLabel" styleClass="history-empty-title"
                        text="Nessuna esperienza nello storico" />
                    <Label fx:id="emptyDescriptionLabel"
                        styleClass="history-empty-description"
                        text="Quando un'esperienza sarà terminata o una prenotazione verrà cancellata, la troverai qui."
                        wrapText="true" />
                    <Button onAction="#handleGoToBookings" styleClass="btn-primary"
                        text="Vai alla Dashboard" />
                </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>