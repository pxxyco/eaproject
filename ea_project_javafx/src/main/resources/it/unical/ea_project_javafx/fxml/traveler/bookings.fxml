<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unical.ea_project_javafx.controller.traveler.BookingsController">
    <stylesheets>
        <URL value="@../../css/common/style.css" />
        <URL value="@../../css/home/home.css" />
        <URL value="@../../css/profile/profile.css" />
        <URL value="@../../css/traveler/traveler.css" />
    </stylesheets>

    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" />
    <Region styleClass="profile-overlay" />

    <BorderPane>
        <top>
            <StackPane fx:id="navbarContainer" />
        </top>
        <center>
            <ScrollPane fitToWidth="true" styleClass="main-scroll">
                <content>
                    <VBox alignment="TOP_CENTER" spacing="24.0">
                        <padding>
                            <Insets bottom="40.0" left="32.0" right="32.0" top="28.0" />
                        </padding>

                        <VBox maxWidth="1000.0" spacing="20.0" styleClass="glass-card">
                            <padding>
                                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="16.0">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="dash-title" text="Le Mie Prenotazioni" />
                                    <Label styleClass="dash-subtitle" text="Gestisci i tuoi viaggi, consulta i dettagli, scarica i biglietti ed esporta in calendario." />
                                </VBox>
                            </HBox>

                            <Label fx:id="statusMessageLabel" managed="false" visible="false" wrapText="true" />

                            <Separator styleClass="nav-divider" />

                            <HBox spacing="16.0">
                                <VBox styleClass="booking-count-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="totalBookingsLabel" styleClass="booking-count-value" text="0" />
                                    <Label styleClass="stat-label" text="Prenotazioni Totali" />
                                </VBox>
                                <VBox styleClass="booking-count-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="confirmedBookingsLabel" styleClass="booking-count-value" text="0" />
                                    <Label styleClass="stat-label" text="Confermate / Attive" />
                                </VBox>
                                <VBox styleClass="booking-count-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="spentTotalLabel" styleClass="booking-count-value" text="€ 0.00" />
                                    <Label styleClass="stat-label" text="Totale Investito" />
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <TextField fx:id="searchFilterField" promptText="Cerca per titolo o destinazione..." styleClass="custom-input" HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="statusFilterCombo" promptText="Stato" styleClass="traveler-search-type" prefWidth="150.0" />
                            </HBox>

                            <TableView fx:id="bookingsTableView" prefHeight="320.0" styleClass="profile-table">
                                <columns>
                                    <TableColumn fx:id="itemTitleColumn" prefWidth="220.0" text="Esperienza / Viaggio" />
                                    <TableColumn fx:id="dateColumn" prefWidth="140.0" text="Data Inizio" />
                                    <TableColumn fx:id="locationColumn" prefWidth="140.0" text="Luogo" />
                                    <TableColumn fx:id="seatsColumn" prefWidth="70.0" text="Posti" />
                                    <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Prezzo" />
                                    <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Stato" />
                                    <TableColumn fx:id="actionsColumn" prefWidth="180.0" text="Azioni" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>

                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>