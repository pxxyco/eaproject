<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>

<StackPane onMouseClicked="#handleClickOverlay" prefHeight="400.0" prefWidth="600.0" styleClass="fullscreen-overlay" stylesheets="@../../../css/activity/photo/photo-style.css" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unical.ea_project_javafx.controller.activity.photo.FullScreenPhotoViewController">
    <children>
        <ImageView fx:id="imageView" fitHeight="400.0" fitWidth="500.0" styleClass="image" />

        <Button fx:id="closeButton" onAction="#handleClose" styleClass="close-button" text="✕" StackPane.alignment="TOP_RIGHT">
            <StackPane.margin>
                <Insets bottom="80.0" left="80.0" right="80.0" top="80.0" />
            </StackPane.margin>
        </Button>
    </children>
</StackPane>
