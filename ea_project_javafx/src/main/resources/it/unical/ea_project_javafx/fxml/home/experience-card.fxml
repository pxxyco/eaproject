<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import it.unical.ea_project_javafx.ui.loading.LoadingRing?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox fx:id="cardRoot" prefHeight="378.0" prefWidth="325.0" styleClass="experience-card"
    xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="it.unical.ea_project_javafx.controller.home.ExperienceCardController">
    <stylesheets>
        <URL value="@../../css/home/experience-card.css" />
    </stylesheets>

    <StackPane fx:id="imageContainer" styleClass="card-image-container" prefHeight="199.0"
        prefWidth="325.0">
        <VBox.margin>
            <Insets bottom="6" left="0" right="0" top="0" />
        </VBox.margin>
        <children>
            <ImageView fx:id="imageView" styleClass="card-image" fitHeight="199.0" fitWidth="315.0"
                preserveRatio="false" />
            <LoadingRing fx:id="imageLoader" maxHeight="30.0" maxWidth="30.0" />
            <HBox spacing="6.0" alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT">
                <StackPane.margin>
                    <Insets top="10.0" right="10.0" />
                </StackPane.margin>
                <children>
                    <Button fx:id="editButton" text="Modifica" visible="false" managed="false"
                        styleClass="btn-card-action" />
                    <Button fx:id="deleteButton" text="Cancella" visible="false" managed="false"
                        styleClass="btn-card-delete" />
                </children>
            </HBox>
        </children>
    </StackPane>

    <VBox prefHeight="192.0" prefWidth="325.0" spacing="4.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="10.0" />
        </padding>
        <children>
            <HBox alignment="CENTER_LEFT">
                <children>
                    <Label fx:id="categoryLabel" styleClass="card-category" />
                    <VBox HBox.hgrow="ALWAYS" />
                    <Label fx:id="ratingLabel" styleClass="card-rating" />
                </children>
            </HBox>

            <Label fx:id="titleLabel" styleClass="card-title" wrapText="true" />
            <Label fx:id="locationLabel" styleClass="card-location" />
            <Label fx:id="dateLabel" styleClass="card-location" />

            <VBox VBox.vgrow="ALWAYS" />

            <HBox alignment="BOTTOM_RIGHT">
                <children>
                    <Label fx:id="priceLabel" styleClass="card-price" />
                </children>
            </HBox>
        </children>
    </VBox>
</VBox>