<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unical.ea_project_javafx.controller.profile.ProfileController">
    <stylesheets>
        <URL value="@../../css/common/style.css" />
        <URL value="@../../css/profile/profile.css" />
        <URL value="@../../css/home/home.css" />
    </stylesheets>

    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" />
    <javafx.scene.layout.Region styleClass="profile-overlay" />

    <BorderPane>
        <top>
            <StackPane fx:id="navbarContainer" />
        </top>
        <center>
            <ScrollPane fitToWidth="true" styleClass="main-scroll">
                <content>
                    <VBox alignment="TOP_CENTER" spacing="24.0">
                        <padding>
                            <Insets bottom="40.0" left="32.0" right="32.0" top="28.0" />
                        </padding>

                        <VBox maxWidth="800.0" spacing="20.0" styleClass="glass-card">
                            <padding>
                                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="18.0">
                                <StackPane fx:id="avatarContainer" minWidth="104.0" minHeight="104.0"
                                           prefWidth="104.0" prefHeight="104.0" maxWidth="104.0" maxHeight="104.0"
                                           styleClass="profile-avatar">
                                    <Label fx:id="avatarInitialsLabel" styleClass="avatar-initials" text="U" />
                                    <ImageView fx:id="profilePhotoImageView" fitWidth="104.0" fitHeight="104.0"
                                               preserveRatio="false" smooth="true" managed="true" />
                                </StackPane>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label fx:id="fullNameLabel" styleClass="profile-title" text="Nome Utente" wrapText="true" />
                                    <Label fx:id="roleBadgeLabel" styleClass="role-badge" text="TRAVELER" />
                                    <Label styleClass="profile-subtitle" text="Gestisci i tuoi dati personali e la foto del profilo." wrapText="true" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" spacing="7.0">
                                    <Button text="Scegli foto" onAction="#handleChooseProfilePhoto" styleClass="btn-secondary" />
                                    <Button fx:id="savePhotoButton" text="Carica foto" onAction="#handleUploadProfilePhoto"
                                            styleClass="btn-primary" managed="false" visible="false" />
                                    <Button fx:id="cancelPhotoButton" text="Annulla scelta" onAction="#handleCancelPhotoSelection"
                                            styleClass="btn-secondary" managed="false" visible="false" />
                                    <Button fx:id="removePhotoButton" text="Rimuovi foto" onAction="#handleRemoveProfilePhoto"
                                            styleClass="btn-secondary" managed="false" visible="false" />
                                </VBox>
                            </HBox>

                            <Label fx:id="statusLabel" managed="false" visible="false" wrapText="true" />
                            <Separator styleClass="nav-divider" />

                            <VBox spacing="14.0">
                                <Label styleClass="section-header" text="Modifica dati personali" />
                                <Label styleClass="section-subtitle" text="Username ed email devono essere univoci. Il nome completo è quello mostrato sul profilo." wrapText="true" />
                                <VBox spacing="4.0">
                                    <Label styleClass="form-label" text="Nome completo *" />
                                    <TextField fx:id="fullNameField" promptText="Nome e cognome" styleClass="custom-input" />
                                </VBox>
                                <HBox spacing="12.0">
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Username *" />
                                        <TextField fx:id="usernameField" promptText="Il tuo username" styleClass="custom-input" />
                                    </VBox>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Indirizzo email *" />
                                        <TextField fx:id="emailField" promptText="nome@esempio.it" styleClass="custom-input" />
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <Button text="Salva modifiche" onAction="#handleSaveProfile" styleClass="btn-primary" />
                                </HBox>
                            </VBox>

                            <Separator styleClass="nav-divider" />

                            <VBox spacing="12.0">
                                <Label styleClass="section-header" text="Informazioni account" />
                                <HBox spacing="12.0">
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Ruolo account" />
                                        <Label fx:id="roleValueLabel" styleClass="custom-input-read" text="-" />
                                    </VBox>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Stato account" />
                                        <Label styleClass="custom-input-read" text="Attivo" />
                                    </VBox>
                                </HBox>
                            </VBox>

                            <Separator styleClass="nav-divider" />

                            <VBox spacing="12.0">
                                <Label styleClass="section-header" text="Sicurezza account" />
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Password" />
                                        <Label styleClass="section-subtitle" text="Per modificare la password dovrai confermare quella attuale." wrapText="true" />
                                    </VBox>
                                    <Button text="Cambia password" onAction="#handleGoToSettings" styleClass="btn-primary" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>
