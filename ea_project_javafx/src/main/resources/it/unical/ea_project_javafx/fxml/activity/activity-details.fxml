<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="760" prefWidth="1300" styleClass="app-root"
    xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="it.unical.ea_project_javafx.controller.activity.ActivityDetailsController">

    <stylesheets>
        <URL value="@../../css/common/style.css" />
        <URL value="@../../css/home/home.css" />
        <URL value="@../../css/activity/activity-details.css" />
        <URL value="@../../css/activity/activity-common.css" />
    </stylesheets>

    <!-- Immagine di sfondo e overlay -->
    <ImageView fx:id="bgImageView" pickOnBounds="true" preserveRatio="false" />
    <Region mouseTransparent="true" styleClass="bg-overlay" />

    <BorderPane styleClass="app-shell">

        <!-- Topbar Dinamica (caricata programmaticamente da setupNavbar) -->
        <top>
            <StackPane fx:id="navbarContainer" />
        </top>

        <center>
            <StackPane fx:id="contentArea" prefHeight="150.0" prefWidth="200.0"
                BorderPane.alignment="CENTER">
                <children>
                    <!-- Overlay di caricamento -->
                    <StackPane fx:id="loadingOverlay" alignment="CENTER"
                        styleClass="loading-overlay">
                        <children>
                            <fx:include fx:id="loadingCard" source="../common/loading-overlay.fxml" />
                        </children>
                    </StackPane>

                    <!-- Contenuto Principale Scrollabile -->
                    <ScrollPane fx:id="contentScroll" fitToWidth="true" managed="false"
                        styleClass="content-scroll" visible="false">
                        <content>
                            <BorderPane>
                                <center>
                                    <VBox maxWidth="1000.0" spacing="24"
                                        styleClass="content-wrapper" BorderPane.alignment="CENTER">
                                        <padding>
                                            <Insets bottom="60" left="60" right="60" top="24" />
                                        </padding>
                                        <children>

                                            <!-- Section Hero Header -->
                                            <StackPane fx:id="hero" maxHeight="200.0"
                                                maxWidth="Infinity" minHeight="200.0"
                                                prefHeight="200.0" styleClass="hero">
                                                <children>
                                                    <ImageView fx:id="heroImage" fitHeight="200.0"
                                                        fitWidth="600.0" preserveRatio="false"
                                                        smooth="true" />
                                                    <VBox alignment="BOTTOM_LEFT" spacing="8"
                                                        styleClass="hero-content">
                                                        <padding>
                                                            <Insets bottom="20" left="28" right="28"
                                                                top="20" />
                                                        </padding>
                                                        <children>
                                                            <HBox spacing="10">
                                                                <children>
                                                                    <Label fx:id="lblCategoria"
                                                                        styleClass="badge-category" />
                                                                    <Label fx:id="lblRating"
                                                                        styleClass="badge-rating"
                                                                        text="★ 4.9" />
                                                                </children>
                                                            </HBox>
                                                            <Label fx:id="lblTitolo"
                                                                styleClass="hero-title" text="Title"
                                                                wrapText="true" />
                                                            <Label fx:id="lblLocalita"
                                                                styleClass="hero-subtitle"
                                                                text="City" />
                                                        </children>
                                                    </VBox>
                                                </children>
                                            </StackPane>

                                            <!-- Menu Sezioni (Descrizione, Itinerario, Foto,
                                            Recensioni) -->
                                            <VBox spacing="10.0" styleClass="content-rows"
                                                VBox.vgrow="ALWAYS">
                                                <children>
                                                    <HBox alignment="CENTER_LEFT" prefHeight="50.0"
                                                        prefWidth="200.0" spacing="40.0">
                                                        <children>
                                                            <Button fx:id="btnDescrizione"
                                                                minHeight="-Infinity"
                                                                minWidth="-Infinity"
                                                                mnemonicParsing="false"
                                                                onAction="#handleDescrizione"
                                                                prefHeight="30.0" prefWidth="100.0"
                                                                styleClass="section-button-active"
                                                                text="Descrizione" />
                                                            <Button fx:id="btnItinerario"
                                                                minHeight="-Infinity"
                                                                minWidth="-Infinity"
                                                                mnemonicParsing="false"
                                                                onAction="#handleItinerario"
                                                                prefHeight="30.0" prefWidth="100.0"
                                                                styleClass="section-button"
                                                                text="Itinerario" />
                                                            <Button fx:id="btnFoto"
                                                                minHeight="-Infinity"
                                                                minWidth="-Infinity"
                                                                mnemonicParsing="false"
                                                                onAction="#handleFoto"
                                                                prefHeight="30.0" prefWidth="100.0"
                                                                styleClass="section-button"
                                                                text="Foto" />
                                                            <Button fx:id="btnRecensioni"
                                                                minHeight="-Infinity"
                                                                minWidth="-Infinity"
                                                                mnemonicParsing="false"
                                                                onAction="#handleRecensioni"
                                                                prefHeight="30.0" prefWidth="100.0"
                                                                styleClass="section-button"
                                                                text="Recensioni" />
                                                        </children>
                                                    </HBox>
                                                    <Separator opacity="0.3" prefWidth="200.0" />
                                                    <StackPane fx:id="bodyContainer"
                                                        alignment="CENTER_LEFT" prefWidth="200.0"
                                                        VBox.vgrow="ALWAYS" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </VBox>
                                </center>

                                <!-- Box di Prenotazione (Lato Destro) -->
                                <right>
                                    <VBox fx:id="bookingCard" maxHeight="-Infinity" minWidth="250.0"
                                        prefWidth="320" spacing="14" styleClass="booking-card"
                                        BorderPane.alignment="TOP_CENTER">
                                        <padding>
                                            <Insets bottom="22" left="22" right="22" top="22" />
                                        </padding>
                                        <children>
                                            <HBox alignment="BASELINE_LEFT" spacing="4">
                                                <children>
                                                    <Label fx:id="lblPrezzo" styleClass="price-big"
                                                        text="da 45€" />
                                                    <Label styleClass="price-suffix"
                                                        text="/ persona" />
                                                </children>
                                            </HBox>
                                            <Label styleClass="field-label" text="Data" />
                                            <DatePicker fx:id="datePicker" editable="false"
                                                maxWidth="Infinity" />
                                            <Label styleClass="field-label" text="Partecipanti" />
                                            <Spinner fx:id="spinnerPartecipanti" maxWidth="Infinity"
                                                styleClass="booking-spinner" />
                                            <Separator />
                                            <HBox alignment="CENTER_LEFT">
                                                <children>
                                                    <Label styleClass="field-label"
                                                        text="Totale stimato" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <Label fx:id="lblTotale"
                                                        styleClass="price-total" text="45€" />
                                                </children>
                                            </HBox>
                                            <Button fx:id="btnPrenota" maxWidth="Infinity"
                                                onAction="#handlePrenota" styleClass="btn-primary"
                                                text="Prenota Ora" />
                                            <Label fx:id="bookingAvailabilityLabel" wrapText="true" styleClass="section-subtitle" />
                                            <Button fx:id="btnContactOrganizer" maxWidth="Infinity"
                                                onAction="#handleContactOrganizer"
                                                styleClass="btn-secondary"
                                                text="Contatta organizzatore" />
                                            <Label styleClass="hint"
                                                text="Cancellazione gratuita fino a 24h prima"
                                                wrapText="true" />
                                        </children>
                                        <BorderPane.margin>
                                            <Insets bottom="30.0" left="30.0" right="30.0"
                                                top="50.0" />
                                        </BorderPane.margin>
                                    </VBox>
                                </right>
                            </BorderPane>
                        </content>
                    </ScrollPane>

                    <!-- Card Nuova Recensione -->
                    <fx:include fx:id="newRecCard" source="reviews/review.fxml" />
                </children>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>