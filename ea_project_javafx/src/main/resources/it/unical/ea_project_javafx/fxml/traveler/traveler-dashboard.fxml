<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox stylesheets="@../../css/screens/traveler/dashboard.css" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
    fx:id="dashboardRoot"
    fx:controller="it.unical.ea_project_javafx.controller.traveler.TravelerDashboardController"
    spacing="34.0" styleClass="traveler-dashboard-content">
    <HBox alignment="CENTER_LEFT" spacing="22.0" styleClass="dashboard-welcome">
        <VBox alignment="CENTER_LEFT" spacing="13.0" minWidth="250.0" HBox.hgrow="ALWAYS"
            styleClass="dashboard-welcome-intro">
            <Label fx:id="welcomeDateLabel" styleClass="dashboard-welcome-eyebrow" text="OGGI" />
            <Label fx:id="welcomeTitleLabel" styleClass="dashboard-welcome-title"
                text="È bello rivederti!" wrapText="true" />
            <Label fx:id="welcomeSubtitleLabel" styleClass="dashboard-welcome-subtitle"
                text="Il prossimo ricordo potrebbe cominciare da qui." wrapText="true" />
            <Region minHeight="8.0" />
            <Label text="OGNI ESPERIENZA COMINCIA CON UNA SCELTA"
                styleClass="dashboard-welcome-signature" wrapText="true" />
        </VBox>
        <VBox prefWidth="360" minWidth="290" maxWidth="390" spacing="18"
            styleClass="dashboard-agenda-note">
            <Label text="LA TUA AGENDA" wrapText="true" styleClass="dashboard-welcome-eyebrow" />
            <VBox spacing="16" alignment="CENTER_LEFT">
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label fx:id="upcomingBookingValue" text="0" styleClass="dashboard-kpi-value" />
                    <Label text="In programma" styleClass="dashboard-kpi-label" />
                </HBox>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label fx:id="favoriteListsValue" text="—" styleClass="dashboard-kpi-value" />
                    <Label text="Raccolte salvate" styleClass="dashboard-kpi-label" />
                </HBox>
            </VBox>
            <Label fx:id="bookingValue" visible="false" managed="false" />
            <Label fx:id="bookingDetail" visible="false" managed="false" />
            <Label fx:id="historicalBookingValue" visible="false" managed="false" />
        </VBox>
    </HBox>
    <Label fx:id="dashboardStatusLabel" managed="false" visible="false" wrapText="true" />
    <VBox spacing="12.0" styleClass="dashboard-section">
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label fx:id="discoveryTitle" styleClass="section-title" text="Scelte per te" />
                <Label fx:id="discoverySubtitle" styleClass="section-subtitle"
                    text="Idee vicine ai tuoi interessi, ai tuoi preferiti e ai viaggi che hai scelto."
                    wrapText="true" />
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="traveler-search-bar">
                <Button onAction="#toggleSearch" styleClass="search-icon-button" text="⌕"
                    accessibleText="Apri ricerca" />
                <TextField fx:id="searchField" managed="false" prefWidth="250.0" visible="false"
                    promptText="Cerca per titolo o luogo..." styleClass="custom-input" />
                <ComboBox fx:id="searchTypeCombo" managed="false" prefWidth="120.0" visible="false"
                    styleClass="traveler-search-type" />
            </HBox>
        </HBox>
        <FlowPane hgap="10" vgap="10">
            <Button text="Per te" userData="RECOMMENDED" onAction="#handleCategory"
                styleClass="btn-secondary" focusTraversable="false" />
            <Button text="Viaggi" userData="TRIP" onAction="#handleCategory"
                styleClass="btn-secondary" focusTraversable="false" />
            <Button text="Escursioni" userData="EXCURSION" onAction="#handleCategory"
                styleClass="btn-secondary" focusTraversable="false" />
            <Button text="Cultura e visite" userData="VISIT" onAction="#handleCategory"
                styleClass="btn-secondary" focusTraversable="false" />
            <Button text="Sapori locali" userData="MEAL" onAction="#handleCategory"
                styleClass="btn-secondary" focusTraversable="false" />
            <Button text="Soggiorni" userData="HOTEL" onAction="#handleCategory"
                styleClass="btn-secondary" focusTraversable="false" />
            <Button text="Trasporti" userData="TRANSPORT" onAction="#handleCategory"
                styleClass="btn-secondary" focusTraversable="false" />
            <Button text="Altre esperienze" userData="OTHER" onAction="#handleCategory"
                styleClass="btn-secondary" focusTraversable="false" />
        </FlowPane>
        <HBox alignment="CENTER" spacing="10.0">
            <Button fx:id="previousRecommendation" onAction="#handlePreviousRecommendation"
                styleClass="carousel-button" text="&lt;" accessibleText="Proposte precedenti"
                focusTraversable="false" />
            <ScrollPane fx:id="recommendedScroll" fitToHeight="true" fitToWidth="true"
                hbarPolicy="NEVER" vbarPolicy="NEVER" styleClass="profile-horizontal-scroll"
                HBox.hgrow="ALWAYS" minHeight="430" prefHeight="430" maxHeight="430">
                <content>
                    <HBox fx:id="recommendedContainer" spacing="16.0" styleClass="activity-row"
                        alignment="TOP_LEFT" />
                </content>
            </ScrollPane>
            <Button fx:id="nextRecommendation" onAction="#handleNextRecommendation"
                styleClass="carousel-button" text="&gt;" accessibleText="Proposte successive"
                focusTraversable="false" />
        </HBox>
    </VBox>
    <VBox spacing="12.0" styleClass="dashboard-section, dashboard-upcoming-section">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Prossime esperienze" />
                <Label styleClass="section-subtitle"
                    text="Le tue prossime 3 prenotazioni, dalla più vicina." wrapText="true" />
            </VBox>
        </HBox>
        <HBox fx:id="upcomingExperienceContainer" spacing="14.0" styleClass="dashboard-upcoming-row" />
    </VBox>
    <VBox spacing="12.0" styleClass="dashboard-section, dashboard-bookings-section">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Gestisci le prenotazioni" />
                <Label styleClass="section-subtitle"
                    text="Cerca, filtra, esporta il calendario o modifica i tuoi programmi."
                    wrapText="true" />
            </VBox>
            <Button onAction="#handleOpenHistory" styleClass="btn-primary"
                text="Consulta lo storico" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="dashboard-booking-filters">
            <TextField fx:id="bookingsSearchField" promptText="Cerca titolo, luogo o data..."
                styleClass="custom-input" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="bookingsPeriodFilter" promptText="Periodo"
                styleClass="traveler-search-type" prefWidth="155.0" />
            <ComboBox fx:id="bookingsStatusFilter" promptText="Stato"
                styleClass="traveler-search-type" prefWidth="190.0" />
        </HBox>
        <Label fx:id="bookingFeedbackLabel" visible="false" managed="false" wrapText="true" />
        <TableView fx:id="bookingsTable" prefHeight="300.0" minHeight="160.0"
            styleClass="profile-table, dashboard-bookings-table">
            <columns>
                <TableColumn fx:id="itemTitleColumn" prefWidth="205.0" text="Esperienza / Viaggio" />
                <TableColumn fx:id="dateColumn" minWidth="180" prefWidth="200"
                    text="Data esperienza" />
                <TableColumn fx:id="bookedAtColumn" visible="false" prefWidth="140.0"
                    text="Prenotata il" />
                <TableColumn fx:id="locationColumn" prefWidth="145.0" text="Luogo" />
                <TableColumn fx:id="seatsColumn" prefWidth="55.0" text="Posti" />
                <TableColumn fx:id="priceColumn" prefWidth="95.0" text="Prezzo" />
                <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Stato" />
                <TableColumn fx:id="actionColumn" minWidth="250" prefWidth="260" text="Azioni" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>