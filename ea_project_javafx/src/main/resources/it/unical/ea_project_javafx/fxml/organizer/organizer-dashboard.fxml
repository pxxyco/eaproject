<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane fx:id="rootStackPane"
    xmlns="http://javafx.com/javafx/21.0.2"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="it.unical.ea_project_javafx.controller.organizer.OrganizerDashboardController">
    <stylesheets>
        <URL value="@../../css/common/style.css" />
        <URL value="@../../css/profile/profile.css" />
        <URL value="@../../css/home/home.css" />
        <URL value="@../../css/organizer/organizer-dashboard.css" />
    </stylesheets>
    <children>
        <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="main-scroll">
            <content>
                <VBox spacing="25.0" fillWidth="true" maxWidth="Infinity"
                    styleClass="dashboard-container">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="dash-title"
                                            text="Dashboard Organizzatore" />
                                        <Label styleClass="dash-subtitle"
                                            text="Gestisci i tuoi eventi, le offerte e controlla le prenotazioni" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Aggiorna" onAction="#handleRefresh"
                                    styleClass="btn-card-action" />
                                <Button text="+ Nuova Offerta" onAction="#handleOpenCreateOffer"
                                    styleClass="btn-card-action" />
                            </children>
                        </HBox>

                        <Label fx:id="dashboardErrorLabel" managed="false" visible="false"
                            wrapText="true"
                            styleClass="dashboard-error" />

                        <HBox fx:id="kpiContainer" spacing="20.0">
                            <children>
                                <VBox minWidth="200.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="kpi-title" text="Offerte Pubblicate" />
                                        <Label fx:id="publishedCountLabel" styleClass="kpi-value"
                                            text="0" />
                                    </children>
                                </VBox>
                                <VBox minWidth="200.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="kpi-title" text="Iscritti Totali" />
                                        <Label fx:id="totalSubscribersLabel" styleClass="kpi-value"
                                            text="0" />
                                    </children>
                                </VBox>
                                <VBox minWidth="200.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="kpi-title" text="Incassi da pagamenti" />
                                        <Label fx:id="totalRevenueLabel"
                                            styleClass="kpi-value-green" text="EUR 0.00" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <TextField fx:id="offerSearchField"
                                promptText="Cerca offerte per titolo o città" HBox.hgrow="ALWAYS"
                                styleClass="custom-input" />
                            <ComboBox fx:id="offerStatusFilter" prefWidth="180.0"
                                styleClass="custom-combo" />
                        </HBox>

                        <VBox spacing="12.0">
                            <children>
                                <Label styleClass="section-header" text="Le Tue Attività" />
                                <FlowPane fx:id="activityCardsContainer" hgap="16.0" vgap="16.0" />
                                <Label fx:id="activitiesPlaceholderLabel"
                                    text="Non hai ancora pubblicato attività."
                                    managed="false" visible="false" styleClass="dash-subtitle" />
                            </children>
                        </VBox>

                        <VBox spacing="12.0">
                            <children>
                                <Label styleClass="section-header" text="I Tuoi Viaggi" />
                                <FlowPane fx:id="tripCardsContainer" hgap="16.0" vgap="16.0" />
                                <Label fx:id="tripsPlaceholderLabel"
                                    text="Non hai ancora pubblicato viaggi."
                                    managed="false" visible="false" styleClass="dash-subtitle" />
                            </children>
                        </VBox>

                        <VBox spacing="12.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-header"
                                    text="Ultimi Utenti Iscritti ai Tuoi Eventi" />
                                <TableView fx:id="subscribersTable" focusTraversable="false"
                                    minHeight="150.0" styleClass="custom-table">
                                    <columns>
                                        <TableColumn fx:id="participantColumn" prefWidth="200.0"
                                            text="Partecipante" />
                                        <TableColumn fx:id="emailColumn" prefWidth="250.0"
                                            text="Email" />
                                        <TableColumn fx:id="activityColumn" prefWidth="250.0"
                                            text="Attività Scelta" />
                                        <TableColumn fx:id="dateColumn" prefWidth="180.0"
                                            text="Data Iscrizione" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</StackPane>