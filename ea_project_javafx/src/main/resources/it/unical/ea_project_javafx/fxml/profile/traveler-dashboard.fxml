<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unical.ea_project_javafx.controller.profile.TravelerDashboardController"
      spacing="16.0">
    <VBox spacing="10.0">
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="3.0">
                <Label styleClass="section-title" text="Attività consigliate" />
                <Label styleClass="section-subtitle" text="Idee selezionate per aiutarti a trovare la prossima esperienza." />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="traveler-search-bar">
                <Button fx:id="searchToggleButton" onAction="#toggleSearch" styleClass="search-icon-button" text="⌕" />
                <TextField fx:id="searchField" managed="false" prefWidth="290.0" visible="false" promptText="Cerca ..." styleClass="custom-input" />
                <ComboBox fx:id="searchTypeCombo" managed="false" prefWidth="128.0" visible="false" styleClass="traveler-search-type" />
            </HBox>
        </HBox>
        <HBox alignment="CENTER" spacing="10.0">
            <Button onAction="#handlePreviousRecommendation" styleClass="carousel-button" text="&lt;" />
            <ScrollPane fx:id="recommendedScroll" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" styleClass="profile-horizontal-scroll" HBox.hgrow="ALWAYS">
                <content><HBox fx:id="recommendedContainer" spacing="16.0" styleClass="activity-row" /></content>
            </ScrollPane>
            <Button onAction="#handleNextRecommendation" styleClass="carousel-button" text="&gt;" />
        </HBox>
    </VBox>

    <VBox spacing="8.0">
        <VBox spacing="3.0">
            <Label styleClass="section-title" text="Le tue prenotazioni" />
            <Label styleClass="section-subtitle" text="Qui trovi le esperienze che hai scelto e il loro stato aggiornato." wrapText="true" />
        </VBox>
        <HBox alignment="TOP_LEFT" spacing="18.0" styleClass="booking-dashboard-row">
        <VBox fx:id="bookingStat" alignment="CENTER" prefHeight="150.0" prefWidth="150.0" styleClass="booking-count-card">
            <Label fx:id="bookingValue" styleClass="booking-count-value" text="0" />
            <Label fx:id="bookingDetail" styleClass="stat-label" text="prenotazioni" />
        </VBox>

        <TableView fx:id="bookingsTable" prefHeight="190.0" styleClass="profile-table" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="activityColumn" prefWidth="240.0" text="Attivita" />
                <TableColumn fx:id="dateColumn" prefWidth="160.0" text="Data e ora" />
                <TableColumn fx:id="locationColumn" prefWidth="160.0" text="Luogo" />
                <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Stato" />
                <TableColumn fx:id="actionColumn" prefWidth="110.0" text="Azioni" />
            </columns>
        </TableView>
        </HBox>
    </VBox>
</VBox>
