<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.scene.image.*?><?import javafx.geometry.Insets?><?import javafx.scene.shape.Circle?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="it.unical.ea_project_javafx.controller.profile.PaymentMethodsController"
    styleClass="account-page">
    <stylesheets>
        <URL value="@../../css/profile/profile.css" />
        <URL value="@../../css/common/style.css" />
    </stylesheets>
    <ImageView fx:id="bgImageView" mouseTransparent="true" opacity="0.12" />
    <BorderPane>
        <top>
            <StackPane fx:id="navbarContainer" />
        </top>
        <center>
            <ScrollPane fitToWidth="true" styleClass="main-scroll">
                <VBox alignment="TOP_CENTER" styleClass="account-layout">
                    <VBox maxWidth="1080" spacing="24">
                        <Label text="PRONTI PER LA PROSSIMA ESPERIENZA" styleClass="account-kicker"
                            wrapText="true" />
                        <Label text="Metodi di pagamento" styleClass="account-title" wrapText="true" />
                        <Label text="Le tue carte di prova e le coordinate del tuo account."
                            styleClass="account-subtitle" wrapText="true" />
                        <Label fx:id="titleLabel" managed="false" visible="false" />
                        <Label fx:id="subtitleLabel" managed="false" visible="false" />
                        <Label fx:id="statusMessageLabel" visible="false" managed="false"
                            wrapText="true" />
                        <VBox fx:id="travelerPaymentsSection" spacing="24">
                            <VBox spacing="16" styleClass="account-panel">
                                <Label text="Il tuo portafoglio dimostrativo"
                                    styleClass="section-header" wrapText="true" />
                                <Label
                                    text="Modalità demo: nessun addebito reale. Salviamo solo circuito, ultime quattro cifre, intestatario e scadenza."
                                    styleClass="section-subtitle" wrapText="true" />
                                <TableView fx:id="cardsTable" prefHeight="220">
                                    <columns>
                                        <TableColumn fx:id="cardTypeColumn" text="Circuito"
                                            prefWidth="130" />
                                        <TableColumn fx:id="cardNumberColumn" text="Carta"
                                            prefWidth="210" />
                                        <TableColumn fx:id="cardHolderColumn" text="Intestatario"
                                            prefWidth="220" />
                                        <TableColumn fx:id="expiryColumn" text="Scadenza"
                                            prefWidth="130" />
                                        <TableColumn fx:id="actionColumn" text="Azioni"
                                            prefWidth="120" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                            <VBox spacing="18" styleClass="account-panel">
                                <Label text="Aggiungi una carta di prova"
                                    styleClass="section-header" wrapText="true" />
                                <HBox spacing="20">
                                    <VBox spacing="16" HBox.hgrow="ALWAYS">
                                        <VBox spacing="7">
                                            <Label text="Intestatario" styleClass="form-label"
                                                wrapText="true" />
                                            <TextField fx:id="cardHolderField"
                                                promptText="Nome e cognome"
                                                styleClass="custom-input" />
                                        </VBox>
                                        <VBox spacing="7">
                                            <Label text="Numero della carta di prova"
                                                styleClass="form-label" wrapText="true" />
                                            <TextField fx:id="cardNumberField"
                                                promptText="4532 **** **** 1234"
                                                styleClass="custom-input" />
                                        </VBox>
                                    </VBox>
                                    <VBox spacing="16" HBox.hgrow="ALWAYS">
                                        <VBox spacing="7">
                                            <Label text="Scadenza MM/AA" styleClass="form-label"
                                                wrapText="true" />
                                            <TextField fx:id="expiryField" promptText="12/29"
                                                styleClass="custom-input" />
                                        </VBox>
                                        <VBox spacing="7">
                                            <Label text="CVV di prova" styleClass="form-label"
                                                wrapText="true" />
                                            <PasswordField fx:id="cvvField" promptText="• • •"
                                                styleClass="custom-input" />
                                        </VBox>
                                    </VBox>
                                </HBox>
                                <Button fx:id="addCardButton" text="Aggiungi carta"
                                    onAction="#handleAddCard" styleClass="btn-primary" />
                            </VBox>
                        </VBox>
                        <VBox fx:id="organizerPayoutSection" spacing="20" styleClass="account-panel">
                            <Label text="Coordinate per gli accrediti" styleClass="section-header"
                                wrapText="true" />
                            <Label
                                text="Dati salvati nel tuo account dimostrativo. Il progetto non esegue bonifici o accrediti reali."
                                styleClass="section-subtitle" wrapText="true" />
                            <VBox spacing="7">
                                <Label text="Intestatario del conto" styleClass="form-label"
                                    wrapText="true" />
                                <TextField fx:id="payoutHolderField"
                                    promptText="Nome o ragione sociale" styleClass="custom-input" />
                            </VBox>
                            <VBox spacing="7">
                                <Label text="IBAN" styleClass="form-label" wrapText="true" />
                                <TextField fx:id="ibanField"
                                    promptText="IT60 X054 2811 1010 0000 0123 456"
                                    styleClass="custom-input" />
                            </VBox>
                            <VBox spacing="7">
                                <Label text="BIC / SWIFT, facoltativo" styleClass="form-label"
                                    wrapText="true" />
                                <TextField fx:id="bicField" promptText="UNCRITMM"
                                    styleClass="custom-input" />
                            </VBox>
                            <Button fx:id="payoutButton" text="Salva coordinate"
                                onAction="#handleSavePayout" styleClass="btn-primary" />
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>