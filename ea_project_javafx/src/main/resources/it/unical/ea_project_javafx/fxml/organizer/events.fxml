<?xml version="1.0" encoding="UTF-8"?>
<?import it.unical.ea_project_javafx.ui.control.PageNavigation?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<StackPane stylesheets="@../../css/screens/organizer/events.css" xmlns:fx="http://javafx.com/fxml/1" fx:id="rootStackPane"
    fx:controller="it.unical.ea_project_javafx.controller.organizer.EventsController">
    <ImageView fx:id="bgImageView" preserveRatio="false" mouseTransparent="true" />
    <BorderPane>
        <top>
            <StackPane fx:id="navbarContainer" />
        </top>
        <center>
            <ScrollPane fitToWidth="true" styleClass="main-scroll">
                <VBox alignment="TOP_CENTER">
                    <VBox spacing="26" maxWidth="1220" styleClass="organizer-workspace">
                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="AREA ORGANIZER" styleClass="account-kicker" />
                                <Label text="Offerte ed eventi" styleClass="dash-title" />
                                <Label
                                    text="Un catalogo operativo: controlla disponibilità e stato, modifica i contenuti oppure crea una nuova esperienza."
                                    styleClass="dash-subtitle" wrapText="true" />
                            </VBox>
                            <Button text="Aggiorna" onAction="#handleRefresh"
                                styleClass="btn-secondary" />
                            <Button text="+ Crea offerta" onAction="#handleOpenCreateOffer"
                                styleClass="btn-primary, btn-create-offer" />
                        </HBox>
                        <Label fx:id="dashboardErrorLabel" visible="false" managed="false"
                            wrapText="true" />
                        <HBox spacing="12">
                            <TextField fx:id="offerSearchField" promptText="Cerca titolo o luogo"
                                HBox.hgrow="ALWAYS" styleClass="custom-input" />
                            <ComboBox fx:id="offerTypeFilter" prefWidth="150" />
                            <ComboBox fx:id="offerStatusFilter" prefWidth="170" />
                        </HBox>
                        <TableView fx:id="offersTable" prefHeight="590" minHeight="250"
                            styleClass="custom-table, organizer-offers-table">
                            <columns>
                                <TableColumn fx:id="titleColumn" text="Offerta" prefWidth="245" />
                                <TableColumn fx:id="typeColumn" text="Tipo" prefWidth="90" />
                                <TableColumn fx:id="placeColumn" text="Luogo" prefWidth="105" />
                                <TableColumn fx:id="periodColumn" text="Date" prefWidth="180" />
                                <TableColumn fx:id="stateColumn" text="Stato" prefWidth="100" />
                                <TableColumn fx:id="seatsColumn" text="Posti liberi / totali"
                                    prefWidth="120" />
                                <TableColumn fx:id="priceColumn" text="Prezzo" prefWidth="90" />
                                <TableColumn fx:id="actionsColumn" text="Azioni" prefWidth="190"
                                    sortable="false" />
                            </columns>
                        </TableView>
                        <PageNavigation fx:id="pagination" />
                        <Label
                            text="Apri un’offerta per visualizzarla; Modifica permette di gestire anche immagini, tappe, date e disponibilità."
                            styleClass="dash-subtitle" wrapText="true" />
                    </VBox>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>