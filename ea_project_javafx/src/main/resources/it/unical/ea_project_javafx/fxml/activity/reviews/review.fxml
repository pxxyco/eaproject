<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane fx:id="root" disable="false" managed="false" maxHeight="300" maxWidth="400"
    minHeight="300" minWidth="400" onMouseClicked="#handleMainFocus" styleClass="popup-overlay-root"
    stylesheets="@../../../css/activity/reviews/review.css" visible="false"
    xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="it.unical.ea_project_javafx.controller.activity.reviews.ReviewController">
    <children>
        <VBox maxWidth="380.0" minWidth="380.0" spacing="16.0" styleClass="popup-recensione">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblTitolo" styleClass="popup-titolo"
                            text="Aggiungi Recensione" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnChiudi" mnemonicParsing="false"
                            onAction="#handleCloseButton" styleClass="btn-elimina" text="✕" />
                    </children>
                </HBox>

                <HBox fx:id="containerStelle" alignment="CENTER" spacing="6.0"
                    styleClass="rating-stelle">
                    <children>
                        <Button fx:id="star1" mnemonicParsing="false" onAction="#star1Button"
                            styleClass="stella" text="☆" />
                        <Button fx:id="star2" mnemonicParsing="false" onAction="#starButton2"
                            styleClass="stella" text="☆" />
                        <Button fx:id="star3" mnemonicParsing="false" onAction="#starButton3"
                            styleClass="stella" text="☆" />
                        <Button fx:id="star4" mnemonicParsing="false" onAction="#starButton4"
                            styleClass="stella" text="☆" />
                        <Button fx:id="star5" mnemonicParsing="false" onAction="#starButton5"
                            styleClass="stella" text="☆" />
                    </children>
                </HBox>

                <TextArea fx:id="txtCommento" prefRowCount="5"
                    promptText="Scrivi qui la tua recensione..." styleClass="textarea-recensione"
                    wrapText="true" />

                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Button fx:id="btnInvia" mnemonicParsing="false"
                            onAction="#handleSendButton" styleClass="btn-invia" text="Invia" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>